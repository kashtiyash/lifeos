# Public Clerk browser configuration (development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Verify these names against current Clerk docs (the older AFTER_SIGN_*_URL names are deprecated).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Server-only credentials. Set actual values in local .env.local or Vercel.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Runtime role (lifeos_runtime), pooled.
DATABASE_URL=
# Migration role (lifeos_migrator), direct connection. Migrations only.
DATABASE_URL_UNPOOLED=
# Maintenance role (lifeos_maintenance). Used only by cron and verified webhooks.
MAINTENANCE_DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Optional heartbeat monitor URL pinged after each successful maintenance run.
HEARTBEAT_URL=

# Optional; only needed if product-owned email is introduced.
RESEND_API_KEY=

# Optional; only needed if Sentry release/source-map upload is adopted.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Observability and security posture (F-4).
# CSP_MODE: report-only (default) | enforce | off. Ship report-only, read the
# preview console, then set enforce. See docs/operations.md.
CSP_MODE=report-only
# LOG_LEVEL: debug | info | warn | error. Defaults to info in production.
LOG_LEVEL=info

# Secret-free test-auth adapter for end-to-end tests. Set to 1 ONLY for local
# or CI runs against a disposable test database. It is ignored in production and
# a production build refuses to start with it set. See docs/testing.md.
E2E_TEST_AUTH=
